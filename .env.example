# =============================================================================
# Required Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Database
DB_USERNAME=postgres
DB_PASSWORD=

# JWT — must be a Base64-encoded 256-bit (32-byte) secret
JWT_SECRET=

# Email (Brevo/Sendinblue) — optional for local dev
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@vehicleexpense.co.za

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AWS S3 (optional for local dev — uses local filesystem storage by default)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=af-south-1
